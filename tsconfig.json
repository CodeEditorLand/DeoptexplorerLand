{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"baseUrl": "./",
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"lib": [
			"esnext"
		],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "Target",
		"removeComments": true,
		"rootDir": "src",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2018"
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"src"
	]
}
